# ---- PostgreSQL ----
DB_HOST=postgres
DB_PORT=5432
DB_NAME=aegisflow
DB_USER=aegis
DB_PASS=aegis_dev_2026
# ---- Kafka ----
KAFKA_BOOTSTRAP=kafka:29092
TOPIC_RAW=txn.raw
TOPIC_SCORED=txn.scored
TOPIC_ALERTED=txn.alerted
CONSUMER_GROUP_SCORER=aegis-scorer
CONSUMER_GROUP_ORCH=aegis-orchestrator
# ---- Redis ----
REDIS_URL=redis://redis:6379/0
VELOCITY_TTL_SECONDS=86400
# ---- MLflow ----
MLFLOW_TRACKING_URI=http://mlflow:5000
# ---- Risk thresholds (overridable per environment) ----
RISK_REVIEW_THRESHOLD=55
RISK_BLOCK_THRESHOLD=80
STRUCTURING_WINDOW_HOURS=24
STRUCTURING_REPORT_LIMIT=10000

# M2 ingestion service
SERVICE_KEY=change-me-service-key

# Host-side Make targets
DATABASE_URL=postgresql+psycopg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:5432/<POSTGRES_DB>
REDIS_URL=redis://localhost:6379/0

# Optional; defaults to the 10th percentile of transaction timestamps
# KNOWN_FRAUD_CUTOFF=2026-09-08T00:00:00Z
